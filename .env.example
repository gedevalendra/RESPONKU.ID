# Supabase — data realtime: comments, reactions, newsletter, bookmarks, sessions
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket ini harus ada di Supabase Storage dan berstatus Public.
SUPABASE_STORAGE_BUCKET=articles
NEXT_PUBLIC_SUPABASE_FUNIKIN_PROVIDER=custom:funikin

# Google OAuth dikonfigurasi di Supabase Dashboard, bukan di frontend.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# MongoDB — data besar/lebih jarang berubah: articles, archives, analytics
MONGODB_URI=
MONGODB_DB_NAME=responku
# MONGODB_USERNAME=
# MONGODB_PASSWORD=

# Optional app controls
# Production: isi dengan URL publik aplikasi, tanpa trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comments publish immediately unless SARA is detected. Uses GROQ_API_KEY/GROQ_MODEL
# when configured, with a local keyword filter as fallback.

# Direct OAuth session (Google/FunikIn). Keep these server-side.
OAUTH_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
GOOGLE_SCOPES=openid email profile

# Groq vision caption generator. Use a Groq model that supports image input.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Web Push / VAPID. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@responku.id

# FunikIn OAuth/OIDC endpoints — fill from FunikIn.
FUNIKIN_CLIENT_ID=
FUNIKIN_CLIENT_SECRET=
FUNIKIN_AUTHORIZATION_URL=
FUNIKIN_TOKEN_URL=
FUNIKIN_USERINFO_URL=
FUNIKIN_SCOPES=openid email profile
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_EMAILS=admin@responku.id,funikindev@gmail.com
